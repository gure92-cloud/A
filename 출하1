<script>
const QUESTIONS = [{"id": 1, "topic": "포장의 기능", "question": "전자제품을 완충재로 감싸 상자에 넣는 가장 직접적인 목적은 무엇인가요?", "options": ["제품의 생산 수량을 늘리기 위해", "운송과 취급 중 내용물을 보호하기 위해", "제품의 전기적 성능을 높이기 위해", "제품의 검사 기준을 변경하기 위해"], "answer": 1, "feedback": ["생산 수량은 생산 계획과 공정 운영에 관련됩니다.", "포장은 제품의 상태와 가치를 보호하며, 완충재는 운송과 취급 중 충격에 의한 손상을 줄입니다.", "완충재 포장은 제품의 전기적 성능을 향상시키는 작업이 아닙니다.", "검사 기준은 요구 품질에 따라 정하며 포장으로 바꾸지 않습니다."], "source": "본문 3쪽"}, {"id": 2, "topic": "포장 제품 취급", "question": "완성된 제품을 외부에 보관할 때 알맞은 조치는 무엇인가요?", "options": ["수량을 확인하기 쉽도록 덮개를 사용하지 않는다.", "합격 제품과 부적합 제품을 섞어 쌓는다.", "공간을 줄이기 위해 정해진 적재 단수를 넘긴다.", "천막이나 비닐 등으로 보호하고 필요한 조치를 한다."], "answer": 3, "feedback": ["외부 환경에 노출되지 않도록 제품을 보호해야 합니다.", "합격 제품과 부적합 제품은 구분하여 보관해야 합니다.", "무너지지 않도록 정해진 적재 단수 이하로 쌓아야 합니다.", "완성된 제품은 창고 보관이 원칙이며, 외부 보관 시에는 천막·비닐 등으로 제품을 보호하고 필요한 조치를 합니다."], "source": "본문 8쪽"}, {"id": 3, "topic": "출하검사의 정의", "question": "요구 품질수준을 만족하는지 확인하여 출하 가능 여부를 판정하는 검사는 무엇인가요?", "options": ["출하검사", "수입검사", "공정검사", "원재료검사"], "answer": 0, "feedback": ["출하검사는 최종 검사를 완료한 출하 대기 제품이 요구 품질수준을 만족하는지 확인하여 출하 가능 여부를 판정합니다.", "수입검사는 들어오는 자재나 외주품 등을 확인하는 검사입니다.", "공정검사는 생산 공정 중에 수행하는 검사입니다.", "원재료검사는 제품 출하 대기 단계의 검사 명칭이 아닙니다."], "source": "본문 20쪽"}, {"id": 4, "topic": "샘플링검사", "question": "로트에서 일부 시료를 뽑아 로트의 합격 여부를 판정하는 검사 방법은 무엇인가요?", "options": ["전수검사", "체크검사", "샘플링검사", "자주검사"], "answer": 2, "feedback": ["전수검사는 검사 대상 제품 전체를 검사하는 방법입니다.", "체크검사는 이전에 발생한 문제점을 다음 로트에서 중점적으로 확인합니다.", "샘플링검사는 로트에서 검사 기준에 따른 시료를 추출하여 검사하는 방법입니다.", "자주검사는 작업자가 자신의 작업 결과를 확인하는 검사로, 로트에서 일부 시료를 뽑는 검사 방법의 명칭이 아닙니다."], "source": "본문 26쪽"}, {"id": 5, "topic": "전수검사", "question": "교재 기준으로, 부적합품이 조금이라도 섞여 들어가는 것을 허용할 수 없을 때 선택하는 검사 방법은 무엇인가요?", "options": ["샘플링검사", "전수검사", "체크검사", "포장검사"], "answer": 1, "feedback": ["샘플링검사는 일부 시료를 검사하므로 교재가 제시한 이 상황의 선택은 아닙니다.", "교재는 부적합품 혼입을 허용할 수 없거나 안전상 중대한 영향이 있는 경우 경제적 비용을 감수하고 전수검사를 선택하도록 설명합니다.", "체크검사는 이전 문제점에 대한 중점 검사이며 전체 제품을 확인한다는 뜻이 아닙니다.", "포장검사는 검사 항목의 구분이며 전체 제품을 검사하는 방법의 명칭이 아닙니다."], "source": "본문 28쪽"}, {"id": 6, "topic": "체크검사", "question": "이전 검사에서 발생한 문제점을 다음 로트에서 중점적으로 검사하는 방법은 무엇인가요?", "options": ["체크검사", "전수검사", "샘플링검사", "수입검사"], "answer": 0, "feedback": ["체크검사는 전 회 발생한 문제점을 차기 로트에서 중점적으로 검사하는 방법입니다.", "전수검사는 검사 대상 전체를 검사하는 방법으로, 이전 문제점을 집중 검사하는 명칭과 다릅니다.", "샘플링검사는 일부 시료를 추출하는 검사 방법입니다.", "수입검사는 들어오는 자재나 외주품을 확인하는 검사입니다."], "source": "본문 26쪽"}, {"id": 7, "topic": "불합격 제품 관리", "question": "불합격 제품의 관리 방법으로 가장 알맞은 것은 무엇인가요?", "options": ["합격 제품과 같은 장소에 섞어 보관한다.", "식별 라벨을 제거하고 다시 출하 대기시킨다.", "불합격 내용을 기록하지 않고 창고에 넣는다.", "불합격임을 표시하고 합격 제품과 분리하여 보관한다."], "answer": 3, "feedback": ["합격 제품과 혼용되지 않도록 보관 장소를 구분해야 합니다.", "불합격 제품은 식별 라벨이나 표시로 상태를 확인할 수 있어야 합니다.", "불합격 내용과 조치 내역 등을 기록하여 관리해야 합니다.", "불합격 제품은 라벨 등으로 식별하고 합격 제품과 분리하여 보관합니다."], "source": "본문 40~41쪽"}, {"id": 8, "topic": "특채", "question": "계약에서 요구하는 고객의 사전 승인을 받은 뒤 해당 부적합품을 사용하거나 진행시키는 처리를 무엇이라고 하나요?", "options": ["폐기", "재작성", "특채", "전수검사"], "answer": 2, "feedback": ["폐기는 사용 요구 사항을 만족시킬 수 없을 때 작업을 무효화하여 버리는 처리입니다.", "재작성은 본래 요건에 맞도록 처음부터 다시 작성하는 처리입니다.", "특채는 최종 성과품의 품질이나 기능에 영향을 미치지 않는다고 판단하여 부적합품을 사용·진행시키는 처리이며, 계약에서 요구하면 고객의 사전 승인을 받아야 합니다.", "전수검사는 검사 대상 전체를 검사하는 방법이며 부적합품의 사용 승인 처리 명칭이 아닙니다."], "source": "본문 38~39쪽"}, {"id": 9, "topic": "선입선출", "question": "먼저 입고된 제품을 먼저 출고하는 보관 원칙은 무엇인가요?", "options": ["선입선출의 원칙", "후입선출의 원칙", "중량 특성의 원칙", "동일성–유사성의 원칙"], "answer": 0, "feedback": ["선입선출은 먼저 들어온 제품을 먼저 내보내는 원칙으로, 수명 주기가 짧거나 감모 위험이 있는 제품에 필요합니다.", "후입선출은 나중에 들어온 것을 먼저 내보내는 방식입니다.", "중량 특성의 원칙은 무게에 따라 보관 위치와 높낮이를 정하는 원칙입니다.", "동일성–유사성의 원칙은 같은 품종은 같은 장소에, 유사품은 가까운 장소에 보관하는 원칙입니다."], "source": "본문 60쪽"}, {"id": 10, "topic": "창고 관리 시스템", "question": "제품의 입고, 보관, 하역, 출하와 재고 정보를 관리하는 창고 관리 시스템의 약자는 무엇인가요?", "options": ["ERP", "MES", "WMS", "MRP"], "answer": 2, "feedback": ["ERP는 기업의 회계·재무·구매·영업 등 경영 활동을 통합적으로 관리합니다.", "MES는 생산 현장의 모니터링, 작업 내역, 불량 관리 등에 초점을 맞춥니다.", "WMS는 Warehouse Management System의 약자로 창고의 입고·보관·하역·출하와 관련 정보를 관리합니다.", "MRP는 생산 계획에 따라 필요한 자재 소요량을 계획하는 시스템입니다."], "source": "본문 10쪽, 64~66쪽"}];
const $=id=>document.getElementById(id);
const letters=['①','②','③','④'];
let answers=Array(QUESTIONS.length).fill(null), current=0, student='', startTime=0, endTime=0, submittedAt='', timer=null, submitted=false;
function duration(ms){const sec=Math.floor(ms/1000);return String(Math.floor(sec/60)).padStart(2,'0')+':'+String(sec%60).padStart(2,'0');}
function updateTime(){$('elapsed').textContent=duration(Date.now()-startTime);}
function render(){
 const q=QUESTIONS[current];$('questionCount').textContent=`문제 ${current+1} / ${QUESTIONS.length}`;$('questionText').textContent=q.question;
 $('options').replaceChildren();q.options.forEach((text,i)=>{const b=document.createElement('button');b.className='option';b.setAttribute('aria-pressed',String(answers[current]===i));const n=document.createElement('span');n.className='letter';n.textContent=letters[i];const t=document.createElement('span');t.textContent=text;b.append(n,t);b.addEventListener('click',()=>{answers[current]=i;render();$('options').children[i].focus();});$('options').append(b);});
 const count=answers.filter(a=>a!==null).length;$('answeredCount').textContent=`응답 ${count} / ${QUESTIONS.length}`;$('progressBar').style.width=`${count/QUESTIONS.length*100}%`;
 $('numbers').replaceChildren();QUESTIONS.forEach((q,i)=>{const b=document.createElement('button');b.className='num'+(answers[i]!==null?' answered':'')+(current===i?' current':'');b.textContent=i+1;b.setAttribute('aria-label',`${i+1}번 문제, ${answers[i]!==null?'응답 완료':'미응답'}`);if(current===i)b.setAttribute('aria-current','step');b.addEventListener('click',()=>{current=i;render();});$('numbers').append(b);});
 $('prevBtn').disabled=current===0;$('nextBtn').disabled=current===QUESTIONS.length-1;
}
$('startForm').addEventListener('submit',e=>{e.preventDefault();const code=$('studentCode').value.trim();if(!code){$('studentCode').setCustomValidity('학번 또는 학생 코드를 입력하세요.');$('studentCode').reportValidity();return;}$('studentCode').setCustomValidity('');student=code;startTime=Date.now();$('studentLabel').textContent=student;$('startScreen').hidden=true;$('examScreen').hidden=false;updateTime();timer=setInterval(updateTime,1000);render();});
$('studentCode').addEventListener('input',()=>$('studentCode').setCustomValidity(''));
$('prevBtn').addEventListener('click',()=>{if(current>0){current--;render();}});
$('nextBtn').addEventListener('click',()=>{if(current<QUESTIONS.length-1){current++;render();}});
function totals(){const correct=answers.filter((a,i)=>a===QUESTIONS[i].answer).length;const unanswered=answers.filter(a=>a===null).length;return {correct,unanswered,wrong:QUESTIONS.length-correct-unanswered,score:correct*10};}
function finish(){
 if(submitted)return;const pending=answers.filter(a=>a===null).length;
 if(!confirm(pending?`${pending}문제가 미응답입니다. 미응답은 0점으로 처리됩니다. 제출하시겠습니까?`:'답안을 제출하고 채점하시겠습니까?'))return;
 submitted=true;endTime=Date.now();submittedAt=new Date(endTime).toISOString();clearInterval(timer);$('examScreen').hidden=true;$('resultScreen').hidden=false;
 const t=totals();$('resultTitle').textContent=`${student}님의 평가 결과`;$('score').textContent=`${t.score}점`;$('stats').replaceChildren();[`정답 ${t.correct}개`,`오답 ${t.wrong}개`,`미응답 ${t.unanswered}개`].forEach(s=>{const p=document.createElement('span');p.textContent=s;$('stats').append(p);});$('resultMeta').textContent=`풀이 시간 ${duration(endTime-startTime)} · 제출 ${new Date(endTime).toLocaleString('ko-KR')}`;
 $('reviews').replaceChildren();QUESTIONS.forEach((q,i)=>{const a=answers[i],ok=a===q.answer;const card=document.createElement('article');card.className='card review';const head=document.createElement('div');head.className='review-head';const title=document.createElement('strong');title.textContent=`${i+1}번 · ${q.topic}`;const badge=document.createElement('span');badge.className='badge'+(ok?'':' wrong');badge.textContent=ok?'정답':a===null?'미응답':'오답';head.append(title,badge);const question=document.createElement('h3');question.textContent=q.question;const list=document.createElement('ol');q.options.forEach((s,j)=>{const li=document.createElement('li');li.textContent=s+(j===q.answer?' ✓ 정답':'')+(j===a?' · 내가 선택':'');if(j===q.answer)li.className='correct-answer';else if(j===a)li.className='selected-wrong';list.append(li);});const exp=document.createElement('div');exp.className='explain';exp.textContent='해설: '+q.feedback[q.answer]+(!ok&&a!==null?' 선택한 보기: '+q.feedback[a]:'');const source=document.createElement('p');source.className='source';source.textContent='학습모듈 '+q.source;card.append(head,question,list,exp,source);$('reviews').append(card);});window.scrollTo({top:0,behavior:'smooth'});
}
$('submitBtn').addEventListener('click',finish);
function summary(){const t=totals();return ['출하관리 CBT 결과',`학생 코드: ${student}`,`점수: ${t.score}/100`,`정답: ${t.correct} / 오답: ${t.wrong} / 미응답: ${t.unanswered}`,`풀이 시간: ${duration(endTime-startTime)}`,`제출 시각: ${new Date(endTime).toLocaleString('ko-KR')}`,...QUESTIONS.map((q,i)=>`${i+1}번: 선택 ${answers[i]===null?'미응답':letters[answers[i]]} / 정답 ${letters[q.answer]} / ${answers[i]===q.answer?'정답':answers[i]===null?'미응답':'오답'}`)].join('\n');}
$('copyBtn').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(summary());$('copyStatus').textContent='결과를 복사했습니다. 선생님에게 보내세요.';}catch(e){$('copyFallback').hidden=false;$('copyFallback').value=summary();$('copyFallback').focus();$('copyFallback').select();$('copyStatus').textContent='아래 결과를 선택한 뒤 직접 복사하세요.';}});
function csvCell(value){let s=String(value??'');if(/^[=+@\-\t\r\n]/.test(s)||/^\s+[=+@\-]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"';}
function csvText(){const t=totals();const rows=[['학생코드','제출시각(UTC)','풀이시간','총점','문제번호','영역','선택번호','정답번호','채점결과'],...QUESTIONS.map((q,i)=>[student,submittedAt,duration(endTime-startTime),t.score,i+1,q.topic,answers[i]===null?'':answers[i]+1,q.answer+1,answers[i]===q.answer?'정답':answers[i]===null?'미응답':'오답'])];return '﻿'+rows.map(row=>row.map(csvCell).join(',')).join('\r\n');}
$('csvBtn').addEventListener('click',()=>{const blob=new Blob([csvText()],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='출하관리_CBT_결과_'+submittedAt.slice(0,10)+'.csv';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);});
$('restartBtn').addEventListener('click',()=>{if(confirm('현재 결과를 저장하거나 복사했나요? 다시 시작하면 현재 결과가 초기화됩니다.'))location.reload();});
</script>
</body>
</html>
